[Unit]
Description=Stable Weather API reverse proxy
Wants=network-online.target
After=network-online.target

[Service]
User=ayu
Group=ayu
RuntimeDirectory=weather-proxy
ExecStartPre=+/usr/local/sbin/weather-deploy recover
ExecStartPre=/usr/sbin/nginx -t -c /opt/weather-risk-api/nginx.conf
ExecStart=/usr/sbin/nginx -c /opt/weather-risk-api/nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -t -c /opt/weather-risk-api/nginx.conf
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGQUIT
KillMode=mixed
TimeoutStopSec=75
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/weather-risk-api /var/lib/weather-risk-api

[Install]
WantedBy=multi-user.target
